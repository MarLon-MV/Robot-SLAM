<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Generic 2D LiDAR: one fixed joint plus a placeholder cylinder. The frame name
       must match the frame_id published by the LiDAR driver. -->
  <xacro:macro name="lidar" params="name:=laser parent_link:=base_link radius:=0.035 height:=0.04 *origin">

    <joint name="${name}_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent_link}"/>
      <child link="${name}"/>
    </joint>

    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${height}"/>
        </geometry>
        <material name="${name}_black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
    </link>
  </xacro:macro>
</robot>
